<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <groupId>io.github.cdpai</groupId>
    <artifactId>cdpai-netrec</artifactId>
    <version>0.2</version>
    <packaging>jar</packaging>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.compiler.source>21</maven.compiler.source>
        <maven.compiler.target>21</maven.compiler.target>
        <main.class>cdpai.netrec.Netrec</main.class>
        <arcadedb.version>25.7.1</arcadedb.version>
        <jackson.version>2.21.2</jackson.version>
        <okhttp.version>4.12.0</okhttp.version>
        <picocli.version>4.7.6</picocli.version>
        <jackson-jq.version>1.6.2</jackson-jq.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>io.github.cdpai</groupId>
            <artifactId>cdpai-gate-client</artifactId>
            <version>0.1</version>
        </dependency>
        <dependency>
            <groupId>com.arcadedb</groupId>
            <artifactId>arcadedb-engine</artifactId>
            <version>${arcadedb.version}</version>
        </dependency>
        <dependency>
            <groupId>com.arcadedb</groupId>
            <artifactId>arcadedb-server</artifactId>
            <version>${arcadedb.version}</version>
        </dependency>
        <dependency>
            <groupId>com.squareup.okhttp3</groupId>
            <artifactId>okhttp</artifactId>
            <version>${okhttp.version}</version>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
            <version>${jackson.version}</version>
        </dependency>
        <dependency>
            <groupId>org.brotli</groupId>
            <artifactId>dec</artifactId>
            <version>0.1.2</version>
        </dependency>
        <dependency>
            <groupId>info.picocli</groupId>
            <artifactId>picocli</artifactId>
            <version>${picocli.version}</version>
        </dependency>
        <dependency>
            <groupId>net.thisptr</groupId>
            <artifactId>jackson-jq</artifactId>
            <version>${jackson-jq.version}</version>
        </dependency>
    </dependencies>

    <build>
        <finalName>netrec</finalName>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.6.0</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals><goal>shade</goal></goals>
                        <configuration>
                            <createDependencyReducedPom>false</createDependencyReducedPom>
                            <filters>
                                <filter>
                                    <artifact>*:*</artifact>
                                    <excludes>
                                        <exclude>META-INF/*.SF</exclude>
                                        <exclude>META-INF/*.DSA</exclude>
                                        <exclude>META-INF/*.RSA</exclude>
                                        <exclude>module-info.class</exclude>
                                    </excludes>
                                </filter>
                                <filter>
                                    <artifact>com.arcadedb:*</artifact>
                                    <excludes>
                                        <exclude>arcadedb-log.properties</exclude>
                                    </excludes>
                                </filter>
                            </filters>
                            <transformers>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                    <mainClass>${main.class}</mainClass>
                                    <manifestEntries>
                                        <Enable-Native-Access>ALL-UNNAMED</Enable-Native-Access>
                                        <Add-Opens>java.base/sun.nio.ch java.base/java.nio.channels.spi</Add-Opens>
                                        <Add-Exports>jdk.unsupported/sun.misc</Add-Exports>
                                    </manifestEntries>
                                </transformer>
                            </transformers>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <!-- netrec.exe, a jr launcher (github.com/jarrunner/jr) with its config baked in, built by
         jr-maven-plugin (on Maven Central). Opt-in, so a plain build stays a plain jar build:
             mvn -Djrexe package                      an exe that runs the jar just built (target/jr)
             mvn -Djrexe -Djr.installDir=<dir> package    and copies it to <dir>
             mvn -Djrexe -Djr.source=url package      a release exe: fetches its jar from this version's
                                                      GitHub release, checked against the sha256 it carries
         The embedded config cannot be overridden by a file beside the exe, so nobody can make
         netrec.exe run other code by planting a .jrc next to it. -->
    <profiles>
        <profile>
            <id>jrexe</id>
            <activation>
                <property>
                    <name>jrexe</name>
                </property>
            </activation>
            <build>
                <plugins>
                    <plugin>
                        <groupId>io.github.jarrunner</groupId>
                        <artifactId>jr-maven-plugin</artifactId>
                        <version>1.1.0</version>
                        <executions>
                            <execution>
                                <goals>
                                    <goal>exe</goal>
                                </goals>
                            </execution>
                        </executions>
                        <configuration>
                            <name>netrec</name>
                            <appId>io.github.cdpai:netrec</appId>
                            <fileDescription>netrec</fileDescription>
                            <productName>netrec</productName>
                            <companyName>cdpai</companyName>
                            <copyright>cdpai contributors</copyright>
                            <icon>${project.basedir}/src/main/jr/netrec.ico</icon>
                            <javaVersion>25+</javaVersion>
                            <jvmMode>dll</jvmMode>
                            <vmArgs>
                                <vmArg>--enable-native-access=ALL-UNNAMED</vmArg>
                            </vmArgs>
                            <jarUrl>https://github.com/cdpai/netrec/releases/download/v${project.version}/netrec.jar</jarUrl>
                            <updateUrl>https://github.com/cdpai/netrec/releases/latest/download/netrec.update.json</updateUrl>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
